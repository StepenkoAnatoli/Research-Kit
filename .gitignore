node_modules/
.DS_Store

# Credentials never belong in this repository (AGENTS.md Rule 6). `doctor` scans for
# them on every run; this is the second line of defence, and both are cheap.
.env
.env.*
.firecrawl/
*.pem
*.key

# Tool byproducts, written by the kit's own entrypoints into whatever directory they
# are run from. Diagnostics, spend, and lock files are machine-local state; they are
# not evidence and must not travel with a repository.
research/raw/.diagnostics.jsonl
research/raw/.usage.jsonl
research/raw/.failures.jsonl
research/raw/.fetches.lock

# CPython bytecode. New as of 2026-09-20: the three Python conformance runners now
# IMPORT a shared module (bin/conformance_common.py) instead of each carrying its own
# copy, and importing a sibling is what makes CPython write a cache directory. Before
# that they imported nothing local and produced none. Unignored, every conformance run
# would leave the working tree dirty - the same defect `.diagnostics.jsonl` had above.
__pycache__/
*.pyc

# Deliberately NOT ignored: research/raw/.fetches.jsonl. The fetch ledger is the
# provenance chain - a repository that ships evidence without it cannot pass its own
# gate, which is exactly what happened when this project was uploaded without its
# dotfiles. If you copy this project by hand, copy research/raw/.* too.
!research/raw/.fetches.jsonl
!research/overrides.log
