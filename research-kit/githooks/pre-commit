#!/bin/sh
# research-kit commit gate - POSIX sh wrapper around bin/gate.mjs.
#
# Three properties this file exists to hold:
#
#   1. FAIL-OPEN, LOUDLY, when node or the kit is missing. A broken gate must not brick
#      the machine. The posture reader below is the ONE deliberate duplication of
#      lib/machine.mjs, and a test pins it to that module in every state.
#
#   2. THE STAGED PATH LIST IS DATA, NOT ARGUMENTS. It arrives on a pipe. The old loop
#      appended two arguments per path to the positional parameters, re-copying the whole
#      growing list on every iteration, so the hook was O(n^2) in staged files: 30,000
#      paths took 225 seconds of silence, which reads as git being broken.
#
#   3. A WATCHDOG KILL IS AN INTERNAL ERROR, NOT A VERDICT. It is named on stderr and
#      then decided by the same posture as any other broken gate - never a hang, and
#      never a silent pass.
#
# Exit-code vocabulary, shared with `bin/gate.mjs --posture`:
#   0 allow   1 a config that parses says fail-closed   2 unreadable and resolved to blocking

set -u

# HOME can be unset (a cron job, a systemd unit, some CI agents), and under `set -u` the
# lines below then stopped the hook with "parameter not set" - every commit refused by a
# shell error. dash does not expand `~` without HOME, so the home directory comes from
# node, which is what lib/machine.mjs uses (homeDir: HOME, else the passwd entry - node
# returns an EMPTY HOME as it is, 2026-09-28). With no node
# either, it stays empty and the fail-open path below says the kit is not deployed.
if [ -z "${HOME:-}" ]; then
  HOME=$(node -e 'const os = require("os"); let h = ""; try { h = os.homedir(); } catch {} process.stdout.write(h || os.userInfo().homedir)' 2>/dev/null) || HOME=
fi

KIT_HOME="${RESEARCH_KIT_HOME:-$HOME/.agents/research-kit}"
CONFIG="${RESEARCH_KIT_CONFIG:-$HOME/.agents/research-kit.config.json}"
GATE_TIMEOUT="${RESEARCH_KIT_GATE_TIMEOUT:-120}"

# --- the self-contained posture reader -------------------------------------------
#
# Mirrors lib/machine.mjs's THREE states: absent / readable / unreadable. sh cannot
# parse JSON, so "readable" is approximated structurally: a config that begins with `{`
# and ends with `}`. That is exactly the shape the truncation defect breaks
# (`{"failOpen": fal`), which is the state this reader exists to catch.
posture_without_kit() {
  _file="$1"
  [ -f "$_file" ] || return 0                       # absent: the fail-open default answers

  # A leading UTF-8 byte-order mark (Windows Notepad writes one) is not part of the JSON,
  # as parseJson in lib/core.mjs drops it; without this the config read as unreadable.
  _bom=$(printf '\357\273\277')
  _first=$(tr -d '[:space:]' < "$_file" | sed "1s/^$_bom//" | cut -c1)
  _last=$(tr -d '[:space:]' < "$_file" | sed 's/.*\(.\)$/\1/')
  if [ "$_first" = "{" ] && [ "$_last" = "}" ]; then
    if grep -q '"failOpen"[[:space:]]*:[[:space:]]*false' "$_file"; then return 1; fi
    return 0
  fi

  # unreadable: hold the last config that parsed, and with nothing to hold, fail CLOSED.
  _snapshot="$_file.last-good"
  if [ -f "$_snapshot" ]; then
    if grep -q '"failOpen"[[:space:]]*:[[:space:]]*false' "$_snapshot"; then return 1; fi
    echo "research gate: $_file does not parse; using the last config that parsed" >&2
    return 0
  fi
  echo "research gate: $_file does not parse and there is no last-good snapshot - failing CLOSED" >&2
  return 2
}

# Once the commit is allowed, the repository's own pre-commit has its say (ADR-0112): git runs
# hooks from ONE directory, and the kit's core.hooksPath made it this one, so .git/hooks/pre-commit
# stopped running (found 2026-10-01, break-test). --git-common-dir, not --git-path hooks: with
# core.hooksPath set, the latter names this directory, and the hook would call itself.
hand_on() {
  _dir=$(git rev-parse --git-common-dir 2>/dev/null) || exit 0
  _own="$_dir/hooks/pre-commit"
  [ -f "$_own" ] && [ -x "$_own" ] || exit 0
  [ "$(cd "$_dir/hooks" 2>/dev/null && pwd -P)" = "$(cd "$(dirname "$0")" && pwd -P)" ] && exit 0
  exec "$_own"
}

decide_without_gate() {
  _why="$1"
  posture_without_kit "$CONFIG"
  _posture=$?
  if [ "$_posture" -eq 0 ]; then
    echo "research gate: $_why - allowing this commit (fail-open). Run: node $KIT_HOME/bin/doctor.mjs" >&2
    hand_on
  fi
  echo "research gate: $_why - BLOCKING (fail-closed)." >&2
  exit 1
}

# --- can we run the gate at all? --------------------------------------------------

command -v node >/dev/null 2>&1 || decide_without_gate "node is not on PATH"
[ -f "$KIT_HOME/bin/gate.mjs" ] || decide_without_gate "the kit is not deployed at $KIT_HOME"

# --- the watchdog -----------------------------------------------------------------

WATCHDOG=""
if command -v timeout >/dev/null 2>&1; then WATCHDOG="timeout $GATE_TIMEOUT"
elif command -v gtimeout >/dev/null 2>&1; then WATCHDOG="gtimeout $GATE_TIMEOUT"
fi
# Where coreutils is absent the gate runs unwatched. A degradation, not a failure.

# --- run it, with the staged list on a pipe ---------------------------------------

# --no-renames: the staged set is every path the commit touches. With rename detection (git's
# default, and diff.renames in the operator's config) `git mv src/app.js research/app.js`
# listed only research/app.js, so a removal of product code that `git rm` would have blocked
# was allowed as a move (found 2026-09-30, break-test).
#
# The list is the FIRST stage of that pipeline, and sh reports only the LAST stage's status: a
# `git diff` that failed (a diff.orderFile naming a missing file, a killed process) reached the
# gate as an EMPTY list - "nothing outside research/ is staged" - and product code was allowed
# while the verdict failed, on a fail-closed machine too (found 2026-10-01, break-test). So git is
# asked first where its status is visible. When it cannot list the paths, the gate still runs,
# with the list UNKNOWN: it judges the index, and blocks while the verdict fails.
if git diff --cached --name-only --no-renames -z >/dev/null; then
  git diff --cached --name-only --no-renames -z | \
    $WATCHDOG node "$KIT_HOME/bin/gate.mjs" --gate commit --staged-stdin
else
  echo "research gate: git could not list the staged paths (its error is above) - judging the commit without the list, so a failing verdict blocks it. Fix git, or override: git commit --no-verify" >&2
  $WATCHDOG node "$KIT_HOME/bin/gate.mjs" --gate commit
fi
status=$?

if [ "$status" -eq 124 ]; then
  decide_without_gate "the gate exceeded ${GATE_TIMEOUT}s and was killed"
fi
if [ "$status" -eq 2 ]; then
  decide_without_gate "the gate reported an internal error"
fi

[ "$status" -eq 0 ] && hand_on
exit "$status"
