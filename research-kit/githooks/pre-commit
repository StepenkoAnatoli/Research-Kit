#!/bin/sh
# research-kit commit gate - POSIX sh wrapper around bin/gate.mjs.
#
# Three properties this file exists to hold:
#
#   1. FAIL-OPEN, LOUDLY, when node or the kit is missing. A broken gate must not brick
#      the machine. The posture reader below is the ONE deliberate duplication of
#      lib/machine.mjs, and a test pins it to that module in every state.
#
#   2. THE STAGED PATH LIST IS DATA, NOT ARGUMENTS. It arrives on a pipe. The old loop
#      appended two arguments per path to the positional parameters, re-copying the whole
#      growing list on every iteration, so the hook was O(n^2) in staged files: 30,000
#      paths took 225 seconds of silence, which reads as git being broken.
#
#   3. A WATCHDOG KILL IS AN INTERNAL ERROR, NOT A VERDICT. It is named on stderr and
#      then decided by the same posture as any other broken gate - never a hang, and
#      never a silent pass.
#
# Exit-code vocabulary, shared with `bin/gate.mjs --posture`:
#   0 allow   1 a config that parses says fail-closed   2 unreadable and resolved to blocking

set -u

KIT_HOME="${RESEARCH_KIT_HOME:-$HOME/.agents/research-kit}"
CONFIG="${RESEARCH_KIT_CONFIG:-$HOME/.agents/research-kit.config.json}"
GATE_TIMEOUT="${RESEARCH_KIT_GATE_TIMEOUT:-120}"

# --- the self-contained posture reader -------------------------------------------
#
# Mirrors lib/machine.mjs's THREE states: absent / readable / unreadable. sh cannot
# parse JSON, so "readable" is approximated structurally: a config that begins with `{`
# and ends with `}`. That is exactly the shape the truncation defect breaks
# (`{"failOpen": fal`), which is the state this reader exists to catch.
posture_without_kit() {
  _file="$1"
  [ -f "$_file" ] || return 0                       # absent: the fail-open default answers

  _first=$(tr -d '[:space:]' < "$_file" | cut -c1)
  _last=$(tr -d '[:space:]' < "$_file" | sed 's/.*\(.\)$/\1/')
  if [ "$_first" = "{" ] && [ "$_last" = "}" ]; then
    if grep -q '"failOpen"[[:space:]]*:[[:space:]]*false' "$_file"; then return 1; fi
    return 0
  fi

  # unreadable: hold the last config that parsed, and with nothing to hold, fail CLOSED.
  _snapshot="$_file.last-good"
  if [ -f "$_snapshot" ]; then
    if grep -q '"failOpen"[[:space:]]*:[[:space:]]*false' "$_snapshot"; then return 1; fi
    echo "research gate: $_file does not parse; using the last config that parsed" >&2
    return 0
  fi
  echo "research gate: $_file does not parse and there is no last-good snapshot - failing CLOSED" >&2
  return 2
}

decide_without_gate() {
  _why="$1"
  posture_without_kit "$CONFIG"
  _posture=$?
  if [ "$_posture" -eq 0 ]; then
    echo "research gate: $_why - allowing this commit (fail-open). Run: node $KIT_HOME/bin/doctor.mjs" >&2
    exit 0
  fi
  echo "research gate: $_why - BLOCKING (fail-closed)." >&2
  exit 1
}

# --- can we run the gate at all? --------------------------------------------------

command -v node >/dev/null 2>&1 || decide_without_gate "node is not on PATH"
[ -f "$KIT_HOME/bin/gate.mjs" ] || decide_without_gate "the kit is not deployed at $KIT_HOME"

# --- the watchdog -----------------------------------------------------------------

WATCHDOG=""
if command -v timeout >/dev/null 2>&1; then WATCHDOG="timeout $GATE_TIMEOUT"
elif command -v gtimeout >/dev/null 2>&1; then WATCHDOG="gtimeout $GATE_TIMEOUT"
fi
# Where coreutils is absent the gate runs unwatched. A degradation, not a failure.

# --- run it, with the staged list on a pipe ---------------------------------------

git diff --cached --name-only -z | \
  $WATCHDOG node "$KIT_HOME/bin/gate.mjs" --gate commit --staged-stdin
status=$?

if [ "$status" -eq 124 ]; then
  decide_without_gate "the gate exceeded ${GATE_TIMEOUT}s and was killed"
fi
if [ "$status" -eq 2 ]; then
  decide_without_gate "the gate reported an internal error"
fi

exit "$status"
